---
// Home page header: the name in small caps on two staggered lines, and a
// large thin circle cut by the column's right line, with one accent point.
import { site } from '../site.config';

const C = { x: 470, y: 150, r: 128 };
const angle = (215 * Math.PI) / 180;
const point = { x: C.x + C.r * Math.cos(angle), y: C.y + C.r * Math.sin(angle) };
---

<header class="masthead">
  <h1 class="name">
    <span class="first">{site.name.first}</span>
    <span class="last">{site.name.last}</span>
  </h1>
  <svg class="deco deco-circle" viewBox="0 0 500 300" preserveAspectRatio="xMaxYMid meet" aria-hidden="true">
    <circle class="ring" cx={C.x} cy={C.y} r={C.r} />
    <circle class="point" cx={point.x.toFixed(1)} cy={point.y.toFixed(1)} r="6" />
  </svg>
</header>
