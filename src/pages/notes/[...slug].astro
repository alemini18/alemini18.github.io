---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <Section label="Notes" more={{ href: '/notes/', text: 'All notes' }}>
    <article class="note">
      <span class="date">{formatDate(post.data.date)}{post.data.draft && ' · draft'}</span>
      <h1 class="page-title">{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </article>
  </Section>
</Base>

<style>
  .note {
    max-width: 40em;
  }
</style>
